+import pytest
+from fastapi.testclient import TestClient
+
+import main
+
+client = TestClient(main.app)
+
+
+@pytest.fixture(autouse=True)
+def clean_products():
+    main.PRODUCTS.clear()
+    yield
+    main.PRODUCTS.clear()
+
+
+def test_list_products_returns_empty_array_when_no_products():
+    response = client.get("/v1/products")
+
+    assert response.status_code == 200
+    assert response.json() == []
+
+
+def test_list_products_returns_all_products():
+    main.PRODUCTS.extend([{"id": 1, "name": "Seed"}, {"id": 2, "name": "Fertilizer"}])
+
+    response = client.get("/v1/products")
+
+    assert response.status_code == 200
+    assert response.json() == [{"id": 1, "name": "Seed"}, {"id": 2, "name": "Fertilizer"}]
