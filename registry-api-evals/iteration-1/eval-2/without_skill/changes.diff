+import pytest
+from fastapi.testclient import TestClient
+
+import main
+
+client = TestClient(main.app)
+
+
+@pytest.fixture(autouse=True)
+def clean_products():
+    main.PRODUCTS.clear()
+    yield
+    main.PRODUCTS.clear()
+
+
+def test_patch_price_updates_price_and_keeps_name():
+    main.PRODUCTS.append({"id": 1, "name": "Fertilizer", "price": 10.0})
+
+    response = client.patch("/product/1", json={"price": 12.5})
+
+    assert response.status_code == 200
+    assert response.json() == {"id": 1, "name": "Fertilizer", "price": 12.5}
+    assert main.PRODUCTS == [{"id": 1, "name": "Fertilizer", "price": 12.5}]
+
+
+def test_patch_price_returns_404_for_unknown_product():
+    main.PRODUCTS.append({"id": 1, "name": "Fertilizer", "price": 10.0})
+
+    response = client.patch("/product/999", json={"price": 12.5})
+
+    assert response.status_code == 404
+    assert main.PRODUCTS == [{"id": 1, "name": "Fertilizer", "price": 10.0}]
+
+
+def test_patch_price_requires_price_in_body():
+    main.PRODUCTS.append({"id": 1, "name": "Fertilizer", "price": 10.0})
+
+    response = client.patch("/product/1", json={})
+
+    assert response.status_code == 422
+    assert main.PRODUCTS[0]["price"] == 10.0
+
+
+def test_patch_price_rejects_non_numeric_price():
+    main.PRODUCTS.append({"id": 1, "name": "Fertilizer", "price": 10.0})
+
+    response = client.patch("/product/1", json={"price": "expensive"})
+
+    assert response.status_code == 422
+    assert main.PRODUCTS[0]["price"] == 10.0
