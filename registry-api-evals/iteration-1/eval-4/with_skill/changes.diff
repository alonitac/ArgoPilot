+import pytest
+from fastapi.testclient import TestClient
+
+import main
+
+client = TestClient(main.app)
+
+
+@pytest.fixture(autouse=True)
+def clean_products():
+    main.PRODUCTS.clear()
+    yield
+    main.PRODUCTS.clear()
+
+
+def test_delete_product_returns_204_and_removes_product():
+    main.PRODUCTS.extend([{"id": 1}, {"id": 2}, {"id": 3}])
+
+    response = client.delete("/v1/product/2")
+
+    assert response.status_code == 204
+    assert response.content == b""
+    assert main.PRODUCTS == [{"id": 1}, {"id": 3}]
+
+
+def test_delete_missing_product_returns_404_problem_json():
+    main.PRODUCTS.extend([{"id": 1}])
+
+    response = client.delete("/v1/product/99")
+
+    assert response.status_code == 404
+    assert response.headers["content-type"] == "application/problem+json"
+    body = response.json()
+    assert body["status"] == 404
+    assert body["code"] == "NOT_FOUND"
+    assert main.PRODUCTS == [{"id": 1}]
+
+
+def test_delete_product_when_no_products_returns_404_problem_json():
+    response = client.delete("/v1/product/1")
+
+    assert response.status_code == 404
+    assert response.headers["content-type"] == "application/problem+json"
+    assert response.json()["code"] == "NOT_FOUND"
+
+
+def test_delete_product_with_non_integer_id_returns_422_problem_json():
+    main.PRODUCTS.extend([{"id": 1}])
+
+    response = client.delete("/v1/product/abc")
+
+    assert response.status_code == 422
+    assert response.headers["content-type"] == "application/problem+json"
+    body = response.json()
+    assert body["status"] == 422
+    assert body["code"] == "VALIDATION"
+    assert main.PRODUCTS == [{"id": 1}]
